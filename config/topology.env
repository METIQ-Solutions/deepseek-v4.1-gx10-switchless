# Cluster topology for a four-node switchless ConnectX ring.
#
# This file is the single machine-readable description of the deployment: the
# scripts source it directly, so it must stay valid shell. It is NOT a
# Kubernetes/Compose-style manifest.
#
# Schema
# ------
#   CLUSTER_*        cluster-wide settings (image, ports, paths, SSH)
#   RANK_<n>_NAME    short name of rank n (n = 0..NODE_COUNT-1)
#   RANK_<n>_SSH     ssh destination used by the scripts, e.g. root@10.20.0.11
#   RANK_<n>_CONTROL_IP       management/rendezvous address of this rank
#   RANK_<n>_CONTROL_IFACE    management/rendezvous interface of this rank
#   RANK_<n>_FABRIC           four "interface:address/prefix" entries, ordered
#                             as port0-lane-a, port0-lane-b, port1-lane-a,
#                             port1-lane-b. Each node has two ConnectX ports
#                             and two lanes per port (two physical links per
#                             direction on a two-rail ring).
#   RING_EDGES       space-separated "fromRank:fromPort->toRank:toPort"
#
# Addressing rules that the scripts enforce
# -----------------------------------------
#   * Every fabric address is IPv4 /30: each physical link is a point-to-point
#     segment shared by exactly two ranks.
#   * The two ranks sharing a segment must use the two usable /30 addresses.
#   * The control plane must not overlap the fabric addressing.
#   * The control interface must not be a ConnectX fabric interface.
#
# Replace every example value below. The example uses RFC 1918 space and
# generic interface names; GB10/GX10 nodes typically expose ConnectX ports as
# enp1s0f0np0 / enp1s0f1np1 (and enP2p1s0f0np0 / enP2p1s0f1np1 on the second
# PCI domain) and management as enP7s7 or enp1s0f0np0 depending on the node.

# --- cluster -----------------------------------------------------------------
CLUSTER_NAME=ds-v41-ring
CLUSTER_TP_SIZE=4
CLUSTER_PP_SIZE=1
NODE_COUNT=4
HEAD_RANK=0
# Compose project name. It is fixed (not directory-derived) so the container
# ownership labels are deterministic and a fence can prove what it is stopping.
COMPOSE_PROJECT=deepseek-v4-1
CONTAINER_NAME=deepseek-v4.1-vllm
API_PORT=8889
MASTER_PORT=25001
SSH_USER=root
SSH_PORT=22
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes"

# Image built by docker/build.sh and present on every rank.
IMAGE=deepseek-v4.1-gx10-switchless:local

# On-host layout.
WORKLOAD_ROOT=/srv/deepseek-v4.1
MODEL_ROOT=/srv/models/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277
CACHE_ROOT=/var/cache/ai-vllm/deepseek-v4.1
NCCL_LIBRARY=/opt/switchless-nccl/libnccl.so.2.30.7

# Host-memory containment (see docs/safety.md). Values assume ~128 GiB nodes.
MEMORY_HIGH=104G
MEMORY_MAX=112G
MEMORY_SWAP_MAX=0
STARTUP_HEADROOM_GIB=16

# Common IPv4 RoCE v2 GID index. Do not guess it: run `scripts/preflight.sh`
# and it will discover the single index shared by both selected HCAs.
NCCL_GID_INDEX=3

# Exact RoCE HCA selection. The "=" prefix means "use exactly these devices and
# fail if any of them is unusable" — never let NCCL pick.
NCCL_IB_HCA="=rocep1s0f0:1,rocep1s0f1:1"

# --- ranks -------------------------------------------------------------------
RANK_0_NAME=gx10-1
RANK_0_SSH=root@10.20.0.11
RANK_0_CONTROL_IP=10.20.0.11
RANK_0_CONTROL_IFACE=enp7s7
RANK_0_FABRIC="enp1s0f0np0:10.10.0.1/30 enP2p1s0f0np0:10.10.0.5/30 enp1s0f1np1:10.10.0.26/30 enP2p1s0f1np1:10.10.0.30/30"

RANK_1_NAME=gx10-2
RANK_1_SSH=root@10.20.0.12
RANK_1_CONTROL_IP=10.20.0.12
RANK_1_CONTROL_IFACE=enp7s7
RANK_1_FABRIC="enp1s0f0np0:10.10.0.9/30 enP2p1s0f0np0:10.10.0.13/30 enp1s0f1np1:10.10.0.2/30 enP2p1s0f1np1:10.10.0.6/30"

RANK_2_NAME=gx10-3
RANK_2_SSH=root@10.20.0.13
RANK_2_CONTROL_IP=10.20.0.13
RANK_2_CONTROL_IFACE=enp7s7
RANK_2_FABRIC="enp1s0f0np0:10.10.0.17/30 enP2p1s0f0np0:10.10.0.21/30 enp1s0f1np1:10.10.0.10/30 enP2p1s0f1np1:10.10.0.14/30"

RANK_3_NAME=gx10-4
RANK_3_SSH=root@10.20.0.14
RANK_3_CONTROL_IP=10.20.0.14
RANK_3_CONTROL_IFACE=enp7s7
RANK_3_FABRIC="enp1s0f0np0:10.10.0.25/30 enP2p1s0f0np0:10.10.0.29/30 enp1s0f1np1:10.10.0.18/30 enP2p1s0f1np1:10.10.0.22/30"

# Physical cycle: 0 -> 1 -> 2 -> 3 -> 0.
#   rank A port 0 is cabled to rank B port 1, and rank B port 0 to the next
#   rank's port 1, so each node has one "downstream" and one "upstream" port.
#   Each port carries two lanes, hence two /30 segments per edge direction in
#   the fabric lists above.
RING_EDGES="0:0->1:1 1:0->2:1 2:0->3:1 3:0->0:1"
