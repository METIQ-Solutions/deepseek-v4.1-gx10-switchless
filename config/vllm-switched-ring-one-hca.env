SERVED_MODEL_NAME=deepseek-v4.1-flash
MODEL_MOUNT_PATH=/models/deepseek-v4.1
API_PORT=8889
MASTER_PORT=25001
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=1
NUM_NODES=4
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=32
GPU_MEMORY_UTILIZATION=0.86
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=128
KV_CACHE_LAYOUT=BLNHC
ATTENTION_BACKEND=FLASHINFER_MLA_SPARSE_DSV41
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_CALL_PARSER=deepseek_v41
SCHEDULING_POLICY=priority
SPECULATIVE_MODE=dspark
SPECULATIVE_CONFIG={"method":"dspark","num_speculative_tokens":5,"draft_sample_method":"probabilistic","enable_adaptive_verification":false}
COMPILATION_CONFIG={"cudagraph_mode":"FULL_DECODE_ONLY"}
DSV41_ENGRAM_DISK=1
HF_HOME=/var/cache/vllm/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
VLLM_CACHE_ROOT=/var/cache/vllm
VLLM_BATCH_INVARIANT=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_ENFORCE_STRICT_TOOL_CALLING=1
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_WORKSPACE_BASE=/var/cache/vllm/flashinfer
TILELANG_CLEANUP_TEMP_FILES=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_NET=IB
NCCL_ALGO=Ring
NCCL_IB_DISABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_IB_MERGE_NICS=0
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_SWITCHED_ONE_HCA=1
NCCL_SKIP_TREE_CONNECT=1
NCCL_CROSS_NIC=0
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_P2P_LEVEL=SYS
NCCL_PROTO=LL,LL128,Simple
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
LD_LIBRARY_PATH=/opt/switched-nccl:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64
VLLM_NCCL_SO_PATH=/opt/switched-nccl/libnccl.so.2.30.7
LD_PRELOAD=/opt/switched-nccl/libnccl.so.2.30.7
TORCH_USE_RTLD_GLOBAL=1
NCCL_SOCKET_FAMILY=AF_INET
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH