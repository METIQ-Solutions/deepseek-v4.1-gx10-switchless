# Experimental switched-fabric reproduction profile.
# This file is intentionally separate from config/topology.env; the original
# switchless topology remains unchanged.
TOPOLOGY_MODE=switched-ring-one-hca
CLUSTER_NAME=ds-v41-switched-ring
CLUSTER_TP_SIZE=4
CLUSTER_PP_SIZE=1
NODE_COUNT=4
HEAD_RANK=0
API_PORT=8889
MASTER_PORT=25001
COMPOSE_PROJECT=deepseek-v4-1-switched
CONTAINER_NAME=deepseek-v4.1-vllm-switched
SSH_USER=ansible
SSH_PORT=22
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=ansible/files/known_hosts"
IMAGE=deepseek-v4.1-gx10-switchless-switched:local
WORKLOAD_ROOT=/srv/deepseek-v4.1-switched
MODEL_ROOT=/srv/models/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277
CACHE_ROOT=/var/cache/ai-vllm/deepseek-v4.1-switched
NCCL_LIBRARY=/opt/switched-nccl/libnccl.so.2.30.7
MEMORY_HIGH=104G
MEMORY_MAX=112G
MEMORY_SWAP_MAX=0
STARTUP_HEADROOM_GIB=16
NCCL_GID_INDEX=3
NCCL_IB_HCA="=rocep1s0f1:1"
RING_EDGES="0:0->1:0 1:0->2:0 2:0->3:0 3:0->0:0"
RANK_0_NAME=rank-0
RANK_0_SSH=root@rank-0.example
RANK_0_CONTROL_IP=198.51.100.21
RANK_0_CONTROL_IFACE=enP7s7
RANK_0_FABRIC="enp1s0f1np1:192.0.2.21/24"
RANK_1_NAME=rank-1
RANK_1_SSH=root@rank-1.example
RANK_1_CONTROL_IP=198.51.100.22
RANK_1_CONTROL_IFACE=enP7s7
RANK_1_FABRIC="enp1s0f1np1:192.0.2.22/24"
RANK_2_NAME=rank-2
RANK_2_SSH=root@rank-2.example
RANK_2_CONTROL_IP=198.51.100.23
RANK_2_CONTROL_IFACE=enP7s7
RANK_2_FABRIC="enp1s0f1np1:192.0.2.23/24"
RANK_3_NAME=rank-3
RANK_3_SSH=root@rank-3.example
RANK_3_CONTROL_IP=198.51.100.24
RANK_3_CONTROL_IFACE=enP7s7
RANK_3_FABRIC="enp1s0f1np1:192.0.2.24/24"