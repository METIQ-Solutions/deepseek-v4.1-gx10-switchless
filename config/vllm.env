# DeepSeek V4.1 Flash — switchless TP4 runtime environment
#
# Consumed as the container environment by compose/compose.yaml. Every value
# here is part of the validated configuration; the comments explain why the
# value is what it is, and which ones are universal versus topology-derived.
#
# This file deliberately contains no per-rank values. NODE_RANK, MASTER_ADDR,
# VLLM_HOST_IP, NCCL_IB_HCA and the rendezvous interface differ per host and are
# supplied by the generated compose/.env (see scripts/start.sh and
# config/topology.env); compose/compose.yaml merges them over this file.

# ---------------------------------------------------------------------------
# Model identity and serving surface
# ---------------------------------------------------------------------------
SERVED_MODEL_NAME=deepseek-v4.1-flash
MODEL_MOUNT_PATH=/models/deepseek-v4.1
API_PORT=8889
MASTER_PORT=25001

# ---------------------------------------------------------------------------
# Distributed topology (dynamic; overridden per rank by compose.yaml)
# ---------------------------------------------------------------------------
TENSOR_PARALLEL_SIZE=4
PIPELINE_PARALLEL_SIZE=1
NUM_NODES=4

# ---------------------------------------------------------------------------
# Context, batching and memory
# ---------------------------------------------------------------------------
# The checkpoint supports 1,048,576 tokens and the deployment exercises it.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=32
GPU_MEMORY_UTILIZATION=0.86

# The model's sparse MLA attention on GB10 accepts an FP8 KV cache, and the
# page geometry is pinned to 128 so the per-layer overrides (compressed 64,
# ratio-2 128, sliding-window 64) apply instead of racing the preferred size.
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=128
KV_CACHE_LAYOUT=BLNHC
ATTENTION_BACKEND=FLASHINFER_MLA_SPARSE_DSV41

# ---------------------------------------------------------------------------
# Parsers
# ---------------------------------------------------------------------------
TOKENIZER_MODE=deepseek_v41
REASONING_PARSER=deepseek_v41
TOOL_CALL_PARSER=deepseek_v41

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# "priority" schedules lower numeric request priority first, with arrival time
# as the tie-breaker, and defaults every request to priority 0. Callers that
# never set a priority therefore keep arrival order.
SCHEDULING_POLICY=priority

# ---------------------------------------------------------------------------
# Speculative decoding (DSpark, k=5)
# ---------------------------------------------------------------------------
# Adaptive verification is deliberately disabled: with this runtime the
# DeepseekV4Indexer backend cannot trim verification requests, so enabling it
# only adds work. DSpark drafting itself stays on.
SPECULATIVE_MODE=dspark
SPECULATIVE_CONFIG={"method":"dspark","num_speculative_tokens":5,"draft_sample_method":"probabilistic","enable_adaptive_verification":false}
COMPILATION_CONFIG={"cudagraph_mode":"FULL_DECODE_ONLY"}

# ---------------------------------------------------------------------------
# Disk-backed Engram
# ---------------------------------------------------------------------------
# The two n-gram tables are ~203 GiB and cannot fit in a 128 GiB unified-memory
# node. They are served from local NVMe instead. See docs/engram.md.
DSV41_ENGRAM_DISK=1

# ---------------------------------------------------------------------------
# Container / cache paths
# ---------------------------------------------------------------------------
HF_HOME=/var/cache/vllm/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
VLLM_CACHE_ROOT=/var/cache/vllm

# ---------------------------------------------------------------------------
# vLLM behaviour
# ---------------------------------------------------------------------------
# CRITICAL for this topology. vLLM's batch-invariance mode rewrites NCCL's
# algorithm matrix *in-process* — NCCL_ALGO=allreduce:tree, one channel,
# NCCL_PROTO=Simple, NCCL_NTHREADS=1 — before the tensor-parallel group is
# built. A Tree all-reduce needs a diagonal rank (rank 0 <-> rank 2), which a
# switchless ring does not cable, so the first collective fails with
# "Rank 0 has no transport for recv peer 2". Keeping this at 0 is what lets
# NCCL_ALGO=Ring from this file survive. See docs/nccl-contract.md.
VLLM_BATCH_INVARIANT=0

VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_ENFORCE_STRICT_TOOL_CALLING=1
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_WORKSPACE_BASE=/var/cache/vllm/flashinfer
TILELANG_CLEANUP_TEMP_FILES=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ---------------------------------------------------------------------------
# NCCL: ring-only transport over the direct ConnectX ring
# ---------------------------------------------------------------------------
# Ring is the only collective algorithm that maps onto a physical cycle. The
# two SWITCHLESS flags are implemented by the patched NCCL build and suppress
# Tree and PAT transport setup, which would otherwise try to reach
# non-neighbour ranks on a switchless ring.
NCCL_NET=IB
NCCL_ALGO=Ring
NCCL_IB_DISABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_SUBNET_PREFIX_LEN=30
NCCL_IB_MERGE_NICS=0
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_SKIP_TREE_CONNECT=1
NCCL_CROSS_NIC=1
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_P2P_LEVEL=SYS
NCCL_PROTO=LL,LL128,Simple
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0

# ---------------------------------------------------------------------------
# NCCL: which library to load (ring-only build, mounted from /opt/switchless-nccl)
# ---------------------------------------------------------------------------
LD_LIBRARY_PATH=/opt/switchless-nccl:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64
VLLM_NCCL_SO_PATH=/opt/switchless-nccl/libnccl.so.2.30.7
LD_PRELOAD=/opt/switchless-nccl/libnccl.so.2.30.7
TORCH_USE_RTLD_GLOBAL=1

# ---------------------------------------------------------------------------
# Distributed rendezvous: the 10 GbE management plane, never the fabric
# ---------------------------------------------------------------------------
# The management plane is reachable by every rank; the switchless ring is not
# an all-to-all fabric. Keeping bootstrap on management is what allows the
# tensor traffic to stay on the direct /30 links.
#
# The interface names and the head address themselves are per-rank and live in
# compose/.env, not here.
NCCL_SOCKET_FAMILY=AF_INET

# ---------------------------------------------------------------------------
# Diagnostics. INFO on INIT/NET/GRAPH is what makes the transport provable.
# ---------------------------------------------------------------------------
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
